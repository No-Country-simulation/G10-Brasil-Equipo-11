# Modo de execução: mock para respostas simuladas.
# Remova ou altere para utilizar o Gemini com uma chave válida.
LLM_MODO=mock

# Google Gemini - opcional no modo mock
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# Chamadas por minuto: use um valor um pouco abaixo do limite do seu plano (AI Studio > limites). 0 desliga o ritmo.
GEMINI_RPM=12

# Aplicação
APP_ENV=development
LOG_LEVEL=INFO
COMMUNITYLAB_MAX_REQUEST_BYTES=10485760

# Oracle Autonomous Database (histórico, curadoria e Insights do painel web)
# disabled = não grava nada; oracle = banco principal do projeto.
# Com oracle: descompacte a wallet na pasta wallet/ (fora do git) e aponte
# CONFIG_DIR e WALLET_LOCATION para ela. O DSN é um alias do tnsnames.ora.
COMMUNITYLAB_DB_MODE=disabled
COMMUNITYLAB_DB_USER=
COMMUNITYLAB_DB_PASSWORD=
COMMUNITYLAB_DB_DSN=
COMMUNITYLAB_DB_CONFIG_DIR=
COMMUNITYLAB_DB_WALLET_LOCATION=
COMMUNITYLAB_DB_WALLET_PASSWORD=
COMMUNITYLAB_DB_POOL_MIN=1
COMMUNITYLAB_DB_POOL_MAX=4
COMMUNITYLAB_DB_POOL_INCREMENT=1
COMMUNITYLAB_DB_POOL_TIMEOUT=60
COMMUNITYLAB_DB_WAIT_TIMEOUT_MS=10000
COMMUNITYLAB_DB_PING_INTERVAL=60
COMMUNITYLAB_PROCESSING_STALE_SECONDS=3600

# API (clientes externos; o painel web usa o login de admin abaixo)
COMMUNITYLAB_API_AUTH_REQUIRED=false
COMMUNITYLAB_API_KEY=
COMMUNITYLAB_ACTOR=curador-local
COMMUNITYLAB_API_URL=http://127.0.0.1:8000
COMMUNITYLAB_API_TIMEOUT_SECONDS=300
COMMUNITYLAB_UI_BACKEND=local

# OCI Object Storage
# local = salva em saida_local/; oci = sobe para o bucket; required = falha se não subir.
OCI_STORAGE_MODE=local
OCI_AUTH_MODE=config_file
OCI_NAMESPACE=
OCI_BUCKET=communitylab-ativos-marketing
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Supabase Postgres - legado, usado só pelo painel Streamlit (plano B)
# Deixe vazio para não gravar nada.
DATABASE_URL=

# Login do painel (um único admin, só para demonstração: a senha fica em texto aqui)
# Sem as duas variáveis, a tela de login avisa e ninguém entra.
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
