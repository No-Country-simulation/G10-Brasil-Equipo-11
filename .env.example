# Modo de execução: mock para respostas simuladas.
# Remova ou altere para utilizar o Gemini com uma chave válida.
LLM_MODO=mock

# Google Gemini - opcional no modo mock
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# OCI Object Storage
# Deixe vazio para utilizar o armazenamento local.
OCI_NAMESPACE=
OCI_BUCKET=communitylab-ativos-marketing
OCI_CONFIG_FILE=~/.oci/config

# Supabase Postgres (histórico e tela Insights) - opcional
# Use a string do "Session pooler" (Project Settings > Database > Connection string).
# A conexão direta só funciona por IPv6. Deixe vazio para não gravar nada.
DATABASE_URL=
