APP_ENV=development
LOG_LEVEL=INFO
COMMUNITYLAB_MAX_REQUEST_BYTES=10485760

# IA
LLM_MODO=mock
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Oracle Database
COMMUNITYLAB_DB_MODE=disabled
COMMUNITYLAB_DB_USER=
COMMUNITYLAB_DB_PASSWORD=
COMMUNITYLAB_DB_DSN=
COMMUNITYLAB_DB_CONFIG_DIR=
COMMUNITYLAB_DB_WALLET_LOCATION=
COMMUNITYLAB_DB_WALLET_PASSWORD=
COMMUNITYLAB_DB_POOL_MIN=1
COMMUNITYLAB_DB_POOL_MAX=4
COMMUNITYLAB_DB_POOL_INCREMENT=1
COMMUNITYLAB_DB_POOL_TIMEOUT=60
COMMUNITYLAB_DB_WAIT_TIMEOUT_MS=10000
COMMUNITYLAB_DB_PING_INTERVAL=60
COMMUNITYLAB_PROCESSING_STALE_SECONDS=3600

# API
COMMUNITYLAB_API_AUTH_REQUIRED=false
COMMUNITYLAB_API_KEY=
COMMUNITYLAB_ACTOR=curador-local
COMMUNITYLAB_API_URL=http://127.0.0.1:8000
COMMUNITYLAB_API_TIMEOUT_SECONDS=300
COMMUNITYLAB_UI_BACKEND=local

# OCI Object Storage
OCI_STORAGE_MODE=local
OCI_AUTH_MODE=config_file
OCI_NAMESPACE=
OCI_BUCKET=communitylab-ativos-marketing
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT