# Copie para .env e preencha. O .env NUNCA vai para o git.

# LLM — sem chave, o sistema roda em modo simulado
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
# LLM_MODO=mock   # descomente para forçar o modo simulado mesmo com chave

# OCI Object Storage — sem estas variáveis, salva em ./saida_local/
OCI_NAMESPACE=
OCI_BUCKET=communitylab-ativos-marketing
OCI_CONFIG_FILE=~/.oci/config
